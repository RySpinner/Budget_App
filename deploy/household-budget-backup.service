# One backup run (started by household-budget-backup.timer). Run it by hand with:
#   sudo systemctl start household-budget-backup && journalctl -u household-budget-backup -n 30
[Unit]
Description=Household spending tracker: nightly backup
After=postgresql.service

[Service]
Type=oneshot
User=budget
Group=budget
ExecStart=/opt/household-budget/deploy/backup.sh /etc/household-budget/backup.env
