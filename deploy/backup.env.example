# Settings for deploy/backup.sh. On the Pi this lives at /etc/household-budget/backup.env.

# Database (the password comes from ~/.pgpass of the user running the backup, never from here)
DB_NAME=household_budget
DB_USER=budget_app
DB_HOST=localhost
DB_PORT=5432

# Where dumps are kept on the Pi, and where the app archives original CSVs
BACKUP_DIR=/var/backups/household-budget
ARCHIVE_DIR=/var/lib/household-budget/archive

# How many to keep on the Pi (and, mirrored, on the remote copy)
KEEP_DAILY=14
KEEP_MONTHLY=12

# Off-Pi copy: rsync over SSH to your Mac / Linux machine / NAS.
# Format user@host:/path  (the folder must exist on that machine)
REMOTE=me@my-nas.local:/backups/household-budget
SSH_KEY=/var/lib/household-budget/.ssh/backup_key
